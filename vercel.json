{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "test \"$(git log -1 --format=%s)\" = 'docs: refresh dashboard guide 2026-09-11 [skip deploy]'",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?__mox_path=/:path*"
    }
  ]
}
